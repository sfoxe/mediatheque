@page
@model Mediatheque.Pages.IndexModel
@{
    ViewData["Title"] = Model.Section switch
    {
        "catalogue" => "Catalogue",
        "saved" => "Mes sauvegardes",
        "history" => "Historique",
        _ => "Accueil"
    };
}

@if (Model.Section == "home")
{
    <header class="page-heading">
        <h1>Bonjour!</h1>
        <p>Prenez le temps de découvrir la médiathèque en ligne.</p>
    </header>
    <section class="hero">
        <span class="eyebrow">Médiathèque FOX</span>
        <h2>Des histoires à<br />un clic!</h2>
        <p>Explorez le catalogue et gardez de côté les ouvrages qui vous inspirent.</p>
        <a class="button primary" href="/?section=catalogue">Explorer le catalogue</a>
    </section>
    <section class="stats">
        <article class="stat"><span>DOCUMENTS AU CATALOGUE</span><strong>@Model.BookCount</strong><small>Livres, BD et magazines</small></article>
        <article class="stat"><span>ACTUELLEMENT DISPONIBLES</span><strong>@Model.AvailableBookCount</strong><small>Prêts à être découverts</small></article>
        <article class="stat"><span>VOS SAUVEGARDES</span><strong>@Model.SavedBookCount</strong><small>@(Model.IsAuthenticated ? "À retrouver à tout moment" : "Connectez-vous pour vos sauvegardes personnelles")</small></article>
    </section>
    <section class="section-heading"><h2>À découvrir</h2><p>Quelques titres de notre collection</p></section>
    <div class="book-grid">
        @foreach (var book in Model.Books)
        {
            <article class="book-card"><span class="book-type">@book.MediaType · @book.PublicationYear</span><h3>@book.Title</h3><p>@book.Author</p><span class="category">@book.Category</span></article>
        }
    </div>
}
else if (Model.Section == "catalogue")
{
    <header class="page-heading"><h1>Le catalogue</h1><p>Trouvez un livre, un auteur ou un support dans nos collections.</p></header>
    <form method="get" class="filters">
        <input type="hidden" name="section" value="catalogue" />
        <input name="q" value="@Model.Q" placeholder="Titre, auteur, ISBN…" aria-label="Recherche" />
        <select name="category" aria-label="Catégorie">
            @foreach (var item in Model.Categories) { <option value="@item" selected="@(Model.Category == item)">@item</option> }
        </select>
        <select name="type" aria-label="Type de support">
            @foreach (var item in Model.MediaTypes) { <option value="@item" selected="@(Model.Type == item)">@item</option> }
        </select>
        <select name="availability" aria-label="Disponibilité">
            @foreach (var item in new[] { "Tous les états", "Disponible", "Indisponible" }) { <option value="@item" selected="@(Model.Availability == item)">@item</option> }
        </select>
        <button class="button primary" type="submit">Rechercher</button>
    </form>
    <p class="result-count">@Model.Books.Count document(s) trouvé(s)</p>
    <div class="table-wrap"><table><thead><tr><th>Titre</th><th>Auteur</th><th>Catégorie</th><th>Support</th><th>Année</th><th>Disponibilité</th><th></th></tr></thead><tbody>
    @foreach (var book in Model.Books)
    {
        <tr><td class="book-title">@book.Title</td><td>@book.Author</td><td>@book.Category</td><td>@book.MediaType</td><td>@book.PublicationYear</td><td><span class="badge @(book.IsAvailable ? "available" : "unavailable")">@(book.IsAvailable ? "Disponible" : "Indisponible")</span></td><td>@if (Model.IsAuthenticated) { <form method="post" asp-page-handler="Save"><input type="hidden" name="id" value="@book.Id" /><button class="icon-button" type="submit" title="Sauvegarder ce document">Sauvegarder</button></form> } else { <a class="text-button" asp-page="/Account">Se connecter</a> }</td></tr>
    }
    @if (Model.Books.Count == 0) { <tr><td colspan="7" class="empty">Aucun document ne correspond à votre recherche.</td></tr> }
    </tbody></table></div>
}
else if (Model.Section == "saved")
{
    <header class="page-heading"><h1>Mes sauvegardes</h1><p>Vos prochaines lectures, rassemblées au même endroit.</p></header>
    @if (!Model.IsAuthenticated)
    {
        <div class="notice">Connectez-vous à votre compte adhérent pour consulter et gérer vos sauvegardes personnelles. <a asp-page="/Account">Connexion</a></div>
    }
    else
    {
        <div class="notice">Ces documents sont associés à votre compte adhérent.</div>
        <div class="table-wrap"><table><thead><tr><th>Titre</th><th>Auteur</th><th>Catégorie</th><th>Support</th><th>Année</th><th>Sauvegardé le</th><th></th></tr></thead><tbody>
        @foreach (var book in Model.SavedBooks)
        {
            <tr><td class="book-title">@book.Title</td><td>@book.Author</td><td>@book.Category</td><td>@book.MediaType</td><td>@book.PublicationYear</td><td>@book.SavedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td><form method="post" asp-page-handler="Remove"><input type="hidden" name="id" value="@book.Id" /><button class="text-button" type="submit">Retirer</button></form></td></tr>
        }
        @if (Model.SavedBooks.Count == 0) { <tr><td colspan="7" class="empty">Aucune sauvegarde pour le moment. Parcourez le catalogue pour en ajouter.</td></tr> }
        </tbody></table></div>
    }
}
else
{
    <header class="page-heading"><h1>Historique des sauvegardes</h1><p>Retrouvez les documents ajoutés ou retirés de votre sélection.</p></header>
    @if (!Model.IsAuthenticated)
    {
        <div class="notice">Connectez-vous à votre compte adhérent pour consulter votre historique personnel. <a asp-page="/Account">Connexion</a></div>
    }
    else
    {
        <div class="table-wrap"><table><thead><tr><th>Action</th><th>Titre</th><th>Auteur</th><th>Date</th></tr></thead><tbody>
        @foreach (var item in Model.History)
        {
            <tr><td><span class="badge @(item.Action == "Sauvegardé" ? "available" : "unavailable")">@item.Action</span></td><td class="book-title">@item.Title</td><td>@item.Author</td><td>@item.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td></tr>
        }
        @if (Model.History.Count == 0) { <tr><td colspan="4" class="empty">Votre historique est encore vide.</td></tr> }
        </tbody></table></div>
    }
}
