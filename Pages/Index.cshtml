@page
@model Mediatheque.Pages.IndexModel
@{
    ViewData["Title"] = Model.Section switch
    {
        "catalogue" => "Catalogue",
        "loans" => "Mes prêts",
        _ => "Accueil"
    };
}

@if (Model.Section == "home")
{
    <header class="page-heading">
        <h1>Bonjour!</h1>
        <p>Prenez le temps de découvrir la médiathèque en ligne.</p>
    </header>
    <section class="hero">
        <span class="eyebrow">Médiathèque FOX</span>
        <h2>Des histoires à<br />un clic!</h2>
        <p>Explorez le catalogue et empruntez vos ouvrages préférés pour 14 jours.</p>
        <a class="button primary" href="/?section=catalogue">Explorer le catalogue</a>
    </section>
    <section class="stats">
        <article class="stat"><span>DOCUMENTS AU CATALOGUE</span><strong>@Model.BookCount</strong><small>Livres, BD et magazines</small></article>
        <article class="stat"><span>ACTUELLEMENT DISPONIBLES</span><strong>@Model.AvailableBookCount</strong><small>Prêts à être découverts</small></article>
        <article class="stat"><span>VOS PRÊTS EN COURS</span><strong>@Model.ActiveLoanCount</strong><small>@(Model.IsAuthenticated ? "Livres actuellement empruntés" : "Connectez-vous pour emprunter un livre")</small></article>
    </section>
    <section class="section-heading"><h2>À découvrir</h2><p>Quelques titres de notre collection</p></section>
    <div class="book-grid">
        @foreach (var book in Model.Books)
        {
            <article class="book-card"><span class="book-type">@book.MediaType · @book.PublicationYear</span><h3>@book.Title</h3><p>@book.Author</p><span class="category">@book.Category</span></article>
        }
    </div>
}
else if (Model.Section == "catalogue")
{
    <header class="page-heading"><h1>Le catalogue</h1><p>Trouvez un livre, un auteur ou un support dans nos collections.</p></header>
    <form method="get" class="filters">
        <input type="hidden" name="section" value="catalogue" />
        <input name="q" value="@Model.Q" placeholder="Titre, auteur, ISBN…" aria-label="Recherche" />
        <select name="category" aria-label="Catégorie">
            @foreach (var item in Model.Categories) { <option value="@item" selected="@(Model.Category == item)">@item</option> }
        </select>
        <select name="type" aria-label="Type de support">
            @foreach (var item in Model.MediaTypes) { <option value="@item" selected="@(Model.Type == item)">@item</option> }
        </select>
        <select name="availability" aria-label="Disponibilité">
            @foreach (var item in new[] { "Tous les états", "Disponible", "Indisponible" }) { <option value="@item" selected="@(Model.Availability == item)">@item</option> }
        </select>
        <button class="button primary" type="submit">Rechercher</button>
    </form>
    <p class="result-count">@Model.Books.Count document(s) trouvé(s)</p>
    <div class="table-wrap"><table><thead><tr><th>Titre</th><th>Auteur</th><th>Catégorie</th><th>Support</th><th>Année</th><th>Disponibilité</th><th></th></tr></thead><tbody>
    @foreach (var book in Model.Books)
    {
        <tr><td class="book-title">@book.Title</td><td>@book.Author</td><td>@book.Category</td><td>@book.MediaType</td><td>@book.PublicationYear</td><td><span class="badge @(book.IsAvailable ? "available" : "unavailable")">@(book.IsAvailable ? $"Disponible ({book.AvailableCopies}/{book.TotalCopies})" : "Indisponible (0 restant)")</span></td><td>@if (!Model.IsAuthenticated) { <a class="text-button" asp-page="/Account">Se connecter</a> } else if (book.IsAvailable) { <form method="post" asp-page-handler="Borrow"><input type="hidden" name="id" value="@book.Id" /><button class="button primary" type="submit">Emprunter (14 jours)</button></form> } else { <span class="muted-text">Indisponible</span> }</td></tr>
    }
    @if (Model.Books.Count == 0) { <tr><td colspan="7" class="empty">Aucun document ne correspond à votre recherche.</td></tr> }
    </tbody></table></div>
}
else
{
    <header class="page-heading"><h1>Mes prêts</h1><p>Vos dates de début et de retour prévues, ainsi que les informations des livres empruntés.</p></header>
    @if (Model.LoanMessage is not null)
    {
        <div class="notice">@Model.LoanMessage</div>
    }
    @if (!Model.IsAuthenticated)
    {
        <div class="notice">La connexion à un compte adhérent est nécessaire pour emprunter et consulter vos prêts. <a asp-page="/Account">Se connecter</a></div>
    }
    else if (Model.Loans.Count == 0)
    {
        <div class="notice">Vous n’avez aucun prêt en cours. <a href="/?section=catalogue">Parcourir le catalogue</a></div>
    }
    else
    {
        <div class="loan-grid">
            @foreach (var loan in Model.Loans)
            {
                <article class="loan-card">
                    @if (!string.IsNullOrWhiteSpace(loan.CoverUrl))
                    {
                        <img class="loan-cover" src="@loan.CoverUrl" alt="Couverture de @loan.Title" loading="lazy" />
                    }
                    <div class="loan-details">
                        <span class="book-type">@loan.MediaType · @loan.Category</span>
                        <h2>@loan.Title</h2>
                        <p class="loan-author">@loan.Author</p>
                        <p><strong>Début du prêt :</strong> @loan.BorrowedAt.ToLocalTime().ToString("dd/MM/yyyy")</p>
                        <p><strong>À rendre avant le :</strong> @loan.DueAt.ToLocalTime().ToString("dd/MM/yyyy")</p>
                        @if (!string.IsNullOrWhiteSpace(loan.Synopsis))
                        {
                            <p class="loan-synopsis">@loan.Synopsis</p>
                        }
                        <div class="loan-actions">
                            @if (!loan.ExtensionUsed)
                            {
                                <form method="post" asp-page-handler="Extend"><input type="hidden" name="id" value="@loan.Id" /><button class="button primary" type="submit">Prolonger de 7 jours</button></form>
                            }
                            else
                            {
                                <span class="muted-text">Prolongation déjà utilisée</span>
                            }
                            <form method="post" asp-page-handler="Return"><input type="hidden" name="id" value="@loan.Id" /><button class="text-button" type="submit">Rendre le livre</button></form>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
}
